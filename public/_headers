# Security headers for Netlify / Cloudflare Pages. The <meta> CSP in index.html
# does not apply to the database worker; the HTTP header does.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Comparison pages of the diagnostics page (public/diagnostics/README.md): only
# the isolation headers differ from Krash's own.
/diagnostics/isolated/*
  Cross-Origin-Embedder-Policy: require-corp

/diagnostics/credentialless/*
  Cross-Origin-Embedder-Policy: credentialless

/diagnostics/no-isolation/*
  ! Cross-Origin-Opener-Policy
